{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sandeep9889123/pm-skills/evaluation/judgement.schema.json",
  "title": "PM Skills Behavioral Benchmark Judgement",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "rubric_version", "raw_output_sha256", "evaluator", "dimensions"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "rubric_version": {"type": "string", "minLength": 1},
    "raw_output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "version", "independent", "blinded"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["human", "model"]},
        "version": {"type": "string", "minLength": 1},
        "independent": {"const": true},
        "blinded": {"type": "boolean"}
      }
    },
    "dimensions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["score", "rationale", "evidence"],
        "properties": {
          "score": {"type": "number", "minimum": 0, "maximum": 5},
          "rationale": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
