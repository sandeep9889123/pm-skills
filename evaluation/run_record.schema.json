{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sandeep9889123/pm-skills/evaluation/run_record.schema.json",
  "title": "PM Skills Behavioral Benchmark Run Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "benchmark_id",
    "suite_path",
    "case_id",
    "case_fingerprint",
    "suite_fingerprint",
    "subject_paths",
    "subject_fingerprint",
    "repository_commit",
    "model",
    "run_index",
    "planned_runs",
    "captured_at",
    "fresh_session",
    "raw_output_path",
    "raw_output_sha256",
    "evaluator_blinded",
    "tool_profile",
    "prompt_delivery"
  ],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "benchmark_id": {"type": "string", "minLength": 1},
    "suite_path": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "case_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "suite_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "subject_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "subject_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repository_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "version", "configuration"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "configuration": {"type": "string", "minLength": 1}
      }
    },
    "run_index": {"type": "integer", "minimum": 1},
    "planned_runs": {"type": "integer", "minimum": 1},
    "captured_at": {"type": "string", "minLength": 1},
    "fresh_session": {"type": "boolean"},
    "raw_output_path": {"type": "string", "minLength": 1},
    "raw_output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "judgement_path": {"type": ["string", "null"]},
    "judgement_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "evaluator_blinded": {"type": ["boolean", "null"]},
    "tool_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools_enabled", "profile"],
      "properties": {
        "tools_enabled": {"type": "boolean"},
        "profile": {"type": "string", "minLength": 1},
        "notes": {"type": ["string", "null"]}
      }
    },
    "prompt_delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_invoked", "corrective_followup_used", "additional_context_given"],
      "properties": {
        "workflow_invoked": {"type": ["string", "null"]},
        "corrective_followup_used": {"type": ["boolean", "null"]},
        "additional_context_given": {"type": ["boolean", "null"]}
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "adapter",
        "endpoint",
        "prompt_bundle_path",
        "prompt_bundle_sha256",
        "request_path",
        "request_sha256",
        "provider_response_path",
        "provider_response_sha256",
        "provider_request_id",
        "response_model",
        "request_parameters"
      ],
      "properties": {
        "mode": {"const": "automated_api"},
        "adapter": {"enum": ["openai-responses", "anthropic-messages"]},
        "endpoint": {"type": "string", "pattern": "^https://"},
        "prompt_bundle_path": {"type": "string", "minLength": 1},
        "prompt_bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "request_path": {"type": "string", "minLength": 1},
        "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "provider_response_path": {"type": "string", "minLength": 1},
        "provider_response_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "provider_request_id": {"type": "string", "minLength": 1},
        "response_model": {"type": "string", "minLength": 1},
        "request_parameters": {"type": "object"}
      }
    },
    "notes": {"type": ["string", "null"]}
  }
}
