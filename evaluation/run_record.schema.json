{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sandeep9889123/pm-skills/evaluation/run_record.schema.json",
  "title": "PM Skills Behavioral Benchmark Run Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "benchmark_id",
    "suite_path",
    "case_id",
    "case_fingerprint",
    "model",
    "run_index",
    "captured_at",
    "fresh_session",
    "raw_output_path",
    "raw_output_sha256"
  ],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "benchmark_id": {"type": "string", "minLength": 1},
    "suite_path": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "case_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "version"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "configuration": {"type": ["string", "null"]}
      }
    },
    "run_index": {"type": "integer", "minimum": 1},
    "captured_at": {"type": "string", "minLength": 1},
    "fresh_session": {"type": "boolean"},
    "raw_output_path": {"type": "string", "minLength": 1},
    "raw_output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "judgement_path": {"type": ["string", "null"]},
    "judgement_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "evaluator_blinded": {"type": ["boolean", "null"]},
    "tool_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools_enabled": {"type": ["boolean", "null"]},
        "profile": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "prompt_delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workflow_invoked": {"type": ["string", "null"]},
        "corrective_followup_used": {"type": ["boolean", "null"]},
        "additional_context_given": {"type": ["boolean", "null"]}
      }
    },
    "notes": {"type": ["string", "null"]}
  }
}
